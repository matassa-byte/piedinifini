# Copia questo file in .env e cambia tutte le password.
# .env non va mai su GitHub (è in .gitignore).

# Indirizzo del sito: in locale http://localhost:8080, sul server https://piedinifini.com
WP_URL=http://localhost:8080
# local, staging oppure production
WP_ENVIRONMENT_TYPE=local
# Solo sul server: dominio per il certificato HTTPS (senza https:// e senza www)
SITE_DOMAIN=piedinifini.com

DB_NAME=piedinifini
DB_USER=piedinifini
DB_PASSWORD=cambiami
DB_ROOT_PASSWORD=cambiami-anche-questa

# Amministratore creato da scripts/setup.sh
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=cambiami
WP_ADMIN_EMAIL=hello@thefancyfactory.com

WOOCOMMERCE_VERSION=11.2.1

# Collegamento con il gestionale di magazzino (da definire con Federico)
PIEDINIFINI_MAGAZZINO_URL=
PIEDINIFINI_MAGAZZINO_TOKEN=
